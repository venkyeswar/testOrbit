# Signs JWTs and derives the key-encryption key for stored model API keys.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=sqlite:///./testorbit.db
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_DAYS=7
REQUEST_TIMEOUT=15

# Parallel background test runs (per API process)
RUN_WORKERS=4
